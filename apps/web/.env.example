# Required on all deployments (customer/staff/developer)
DEPLOYMENT_TYPE=developer
NEXT_PUBLIC_DEPLOYMENT_TYPE=developer

# Supabase/OpenAI (all deployments)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MAX_OUTPUT_TOKENS_GENERAL_CHAT=
OPENAI_MAX_OUTPUT_TOKENS_RECOMMENDATION=
OPENAI_MAX_OUTPUT_TOKENS_APPRAISAL=
COOKIE_SECRET=

# Tenant scope: required on customer/staff, optional on developer
TENANT_ID=
NEXT_PUBLIC_TENANT_ID=

# Runtime toggles
OPENAI_MODEL=gpt-4.1-nano
ENABLE_GENERAL_CHAT_AI=1
CHAT_MEMORY_V1=1
NEXT_PUBLIC_ENABLE_DEVELOPER_ROLE=1
NEXT_PUBLIC_ENABLE_ROLE_SWITCHER=1
NEXT_PUBLIC_PILOT_DEFAULT_ROLE=store_staff

# Access tokens
# Customer deployment: TRADE_ACCESS_TOKEN
# Staff deployment: STAFF_ACCESS_TOKEN, DEV_ACCESS_TOKEN
# Developer/local: optional
STAFF_ACCESS_TOKEN=
TRADE_ACCESS_TOKEN=
DEV_ACCESS_TOKEN=

# QA/CI only
QA_MODE=
RECOMMENDATION_QA_LOG_PATH=
