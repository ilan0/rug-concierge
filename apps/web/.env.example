# Core runtime
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
COOKIE_SECRET=

# Tenant and branding
TENANT_ID=
STORE_NAME=
STORE_LOGO_URL=

# Access mode
# Unset for open mode; set 4-digit value for passcode-gated mode.
STORE_PASSCODE=

# Optional tunables
OPENAI_MODEL=gpt-4.1-nano
OPENAI_MAX_OUTPUT_TOKENS_GENERAL_CHAT=
OPENAI_MAX_OUTPUT_TOKENS_RECOMMENDATION=
ENABLE_GENERAL_CHAT_AI=1
CHAT_MEMORY_V1=1

# QA only
RECOMMENDATION_QA_LOG_PATH=
