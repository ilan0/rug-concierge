{
  "name": "rug-concierge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "lint": "npm --workspace apps/web run lint",
    "qa": "npm run qa:functional",
    "qa:functional": "node scripts/qa.mjs functional",
    "qa:quality": "node scripts/qa.mjs quality",
    "qa:all": "npm run qa:functional && npm run qa:quality"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "fast-check": "^4.5.3",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
