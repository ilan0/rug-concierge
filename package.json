{
  "name": "rug-concierge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "dev:site": "npm --workspace apps/site run dev",
    "build": "npm --workspace apps/web run build",
    "build:site": "npm --workspace apps/site run build",
    "lint": "npm --workspace apps/web run lint",
    "test:concierge-rework": "npm --workspace apps/web exec tsx ../../scripts/testing/concierge-rework-scenarios.ts",
    "test:concierge-gauntlet": "npm --workspace apps/web exec tsx ../../scripts/testing/concierge-500-gauntlet.ts",
    "test:intake-attribution": "npm --workspace apps/web exec tsx ../../scripts/testing/intake-attribution-regression.ts",
    "test:intake-attribution-smoke": "NODE_OPTIONS='--conditions=react-server' npm --workspace apps/web exec tsx ../../scripts/testing/intake-attribution-smoke.ts",
    "audit:inventory-enrichment": "npm --workspace apps/web exec tsx ../../scripts/testing/audit-inventory-enrichment.ts",
    "reconcile:inventory-enrichment": "npm --workspace apps/web exec tsx ../../scripts/reconcile-inventory-enrichment.ts",
    "reprocess:inventory-enrichment": "NODE_OPTIONS='--conditions=react-server' npm --workspace apps/web exec tsx ../../scripts/reprocess-inventory-enrichment.ts",
    "test:openai-rug-enhancement": "npm exec tsx -- scripts/testing/openai-rug-enhancement.ts",
    "test:gemini-rug-enhancement": "npm exec tsx -- scripts/testing/gemini-rug-enhancement.ts",
    "build:live-intake-dataset": "npm exec tsx -- scripts/testing/live-intake/build-live-intake-dataset.ts",
    "run:live-intake-ui": "npm exec tsx -- scripts/testing/live-intake/run-live-intake-ui.ts",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "quality:release": "npm --workspace apps/web exec tsc --noEmit && npm --workspace apps/web run lint && npm --workspace apps/web run build && npm run check:docs && npm run check:migrations"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
